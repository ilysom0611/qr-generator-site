---
import '../styles/global.css';
import '../styles/tool.css';
import '../styles/landing.css';
import { useTranslations, getLocaleFromUrl, getLocalizedPath } from '@/i18n/utils';
import { locales, localeLabels, localeHtmlLang, localeOgLocale, defaultLocale, isLocale, type Locale } from '@/i18n/config';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: 'software' | 'faq' | null;
  faqItems?: Array<{ question: string; answer: string }>;
  locale?: Locale;
}

const { title, description, canonical, schema, faqItems, locale: propLocale } = Astro.props;

// Resolve locale with priority: explicit prop > Astro.currentLocale (set by i18n fallback) > URL prefix > default.
// Astro.currentLocale is provided by Astro 4's i18n routing; on rewrites it reflects the original request locale.
const urlSeg = Astro.url.pathname.split('/').filter(Boolean)[0];
const fromUrl: Locale = isLocale(urlSeg) ? urlSeg : defaultLocale;
const resolvedLocale: Locale = propLocale ?? (Astro.currentLocale as Locale | undefined) ?? fromUrl;
const t = useTranslations(resolvedLocale);

// Canonical: for non-default locales, reconstruct the original /xx/... URL since
// Astro.url.pathname is the rewrite target (e.g. "/url-qr-code/" not "/cn/url-qr-code/").
const rewrittenPath = Astro.url.pathname;
const localizedPath =
  resolvedLocale === defaultLocale
    ? rewrittenPath
    : '/' + resolvedLocale + (rewrittenPath === '/' ? '' : rewrittenPath);
const canonicalUrl = canonical ?? new URL(localizedPath, Astro.site).href;

// Absolute URL for OG image (required by Twitter/Facebook/LinkedIn)
const ogImageUrl = new URL('/og-image.svg', Astro.site).href;

const softwareSchema = schema === 'software' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: t('og.siteName'),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (browser-based)',
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
} : null;

const faqSchema = schema === 'faq' && faqItems ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer
    }
  }))
} : null;

const allSchemas = [softwareSchema, faqSchema].filter(Boolean);

// Hreflang alternates — always emit all 3 (Astro native i18n handles fallback)
const alternates = locales.map((loc) => ({
  hreflang: localeHtmlLang[loc],
  href: new URL(getLocalizedPath(Astro.url.pathname, loc), Astro.site).href,
}));

const ogLocale = localeOgLocale[resolvedLocale];
const htmlLang = localeHtmlLang[resolvedLocale];
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="googlef7c57a0ab687b5ef" />
  <meta name="theme-color" content="#0066ff" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Hreflang: tell crawlers about all 3 language versions -->
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}

  <!-- Performance: preload critical OG image so social scrapers don't block -->
  <link rel="preload" as="image" href={ogImageUrl} type="image/svg+xml" fetchpriority="low" />

  <!-- Open Graph (Facebook, LinkedIn, Discord, Slack) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={t('og.imageAlt')} />
  <meta property="og:site_name" content={t('og.siteName')} />

  <!-- Twitter Card (large image for better engagement) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={t('og.imageAlt')} />

  {allSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href={getLocalizedPath('/', resolvedLocale)} class="brand">{t('brand.name')}</a>
      <nav class="site-nav">
        <a href={getLocalizedPath('/about', resolvedLocale)}>{t('nav.about')}</a>
        <div class="locale-switcher" aria-label={t('nav.language')}>
          {locales.map((loc) => (
            <a
              href={getLocalizedPath(Astro.url.pathname, loc)}
              hreflang={localeHtmlLang[loc]}
              aria-current={loc === resolvedLocale ? 'page' : 'false'}
              class:list={['locale-link', { active: loc === resolvedLocale }]}
            >{localeLabels[loc]}</a>
          ))}
        </div>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>{t('footer.tagline')}</p>
      <p>
        <a href={getLocalizedPath('/privacy', resolvedLocale)}>{t('footer.privacy')}</a> ·
        <a href={getLocalizedPath('/terms', resolvedLocale)}>{t('footer.terms')}</a> ·
        <a href={getLocalizedPath('/contact', resolvedLocale)}>{t('footer.contact')}</a>
      </p>
    </div>
  </footer>
</body>
</html>
