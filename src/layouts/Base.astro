---
import '../styles/global.css';
import '../styles/tool.css';
import '../styles/landing.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: 'software' | 'faq' | null;
  faqItems?: Array<{ question: string; answer: string }>;
}

const { title, description, canonical, schema, faqItems } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

const softwareSchema = schema === 'software' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'QR Code Generator',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (browser-based)',
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
} : null;

const faqSchema = schema === 'faq' && faqItems ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer
    }
  }))
} : null;

const allSchemas = [softwareSchema, faqSchema].filter(Boolean);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {allSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="brand">QR Generator</a>
      <nav>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>100% private. All QR codes are generated in your browser. No upload, no tracking.</p>
      <p>
        <a href="/privacy">Privacy</a> ·
        <a href="/terms">Terms</a> ·
        <a href="/contact">Contact</a>
      </p>
    </div>
  </footer>
  <!-- Cloudflare Web Analytics (placeholder; real beacon added in M5/M6) -->
</body>
</html>