---
import Base from '../layouts/Base.astro';

const faqItems = [
  { question: 'How do I scan a Text QR code?', answer: 'Open your phone camera, point at the QR. The plain text content appears after you tap the prompt.' },
  { question: 'How much text can a QR code hold?', answer: 'Up to roughly 4,000 alphanumeric characters or 2,000 bytes, depending on the error correction level you choose.' },
  { question: 'Is there character encoding I should know about?', answer: 'We encode in UTF-8 by default, so emoji and non-Latin scripts are supported.' },
  { question: 'Can I update the text after sharing?', answer: 'No. The QR code encodes a static snapshot. Re-generate and re-share to update.' }
];

const relatedTypes = [
  { slug: 'url-qr-code', label: 'URL QR Code' },
  { slug: 'wifi-qr-code', label: 'WiFi QR Code' },
  { slug: 'vcard-qr-code', label: 'vCard QR Code' },
  { slug: 'email-qr-code', label: 'Email QR Code' },
  { slug: 'phone-qr-code', label: 'Phone QR Code' },
  { slug: 'sms-qr-code', label: 'SMS QR Code' },
  { slug: 'location-qr-code', label: 'Location QR Code' },
  { slug: 'qr-code-generator', label: 'All QR Code Tools' }
];

---
<Base
  title="Free Text QR Code Generator — Encode Any Message"
  description="Create a Text QR code that holds any UTF-8 message up to several thousand characters. 100% private, browser-based."
  schema="faq"
  faqItems={faqItems}>
  <section class="landing-hero">
    <div class="container">
      <h1>Free Text QR Code Generator</h1>
      <p>Encode any message into a QR code. Notes, serial numbers, instructions, Wi-Fi setup text — anything UTF-8.</p>
      <a href="/#type=text" class="cta">Try the Text QR Code Generator</a>
    </div>
  </section>
  <section class="landing-howto">
    <div class="container">
      <h2>How to use</h2>
      <ol>
        <li>Select Text type and paste or type your message.</li>
        <li>Pick an error correction level (H survives up to 30% damage).</li>
        <li>Download as PNG, SVG, or JPG and print or share.</li>
      </ol>
    </div>
  </section>
  <section class="landing-faq">
    <div class="container">
      <h2>Frequently asked questions</h2>
      {faqItems.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="landing-related">
    <div class="container">
      <h2>Related tools</h2>
      <ul>
        {relatedTypes.map((r) => (
          <li><a href={`/${r.slug}`}>{r.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>