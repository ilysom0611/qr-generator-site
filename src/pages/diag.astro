---
import Base from "../layouts/Base.astro";
export const prerender = true;
---
<Base title="diag" description="diag">
<pre id="diag">
url.pathname: {Astro.url.pathname}
url.href: {Astro.url.href}
request.url: {Astro.request.url}
currentLocale: {Astro.currentLocale}
preferredLocale: {Astro.preferredLocale}
preferredLocaleList: {JSON.stringify(Astro.preferredLocaleList)}
</pre>
</Base>