---
import Base from '../layouts/Base.astro';
import { getLocaleFromUrl } from '@/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
---
<Base title="Contact — Free QR Code Generator" description="Contact information for the free QR code generator." locale={locale}>
  <section class="container" style="padding: 2rem 0;">
    <h1>Contact</h1>
    <p>For bug reports or feature requests, please open an issue on our public repository.</p>
    <p>This site is operated by an individual. We do not provide support for QR code scanning on specific devices — please contact your device manufacturer for that.</p>
  </section>
</Base>