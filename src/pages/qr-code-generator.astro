---
import Base from '../layouts/Base.astro';

const faqItems = [
  { question: 'What types of QR codes can I generate?', answer: 'URL, Text, WiFi, vCard, Email, Phone, SMS, and Location. All 8 types are free.' },
  { question: 'Is this really free?', answer: 'Yes, completely free. No signup, no watermark, no limits.' },
  { question: 'How private is this?', answer: 'All generation happens in your browser. Your content is never uploaded to any server.' },
  { question: 'Which format should I download?', answer: 'PNG for photos/print, SVG for high-quality scaling, JPG for smaller file size.' },
  { question: 'Can I add my logo?', answer: 'Yes. Upload any image; we composite it in the center. Error correction auto-promotes to H for scannability.' }
];

const relatedTypes = [
  { slug: 'url-qr-code', label: 'URL QR Code' },
  { slug: 'wifi-qr-code', label: 'WiFi QR Code' },
  { slug: 'vcard-qr-code', label: 'vCard QR Code' },
  { slug: 'email-qr-code', label: 'Email QR Code' },
  { slug: 'phone-qr-code', label: 'Phone QR Code' },
  { slug: 'sms-qr-code', label: 'SMS QR Code' },
  { slug: 'location-qr-code', label: 'Location QR Code' },
  { slug: 'text-qr-code', label: 'Text QR Code' }
];

---
<Base
  title="Free QR Code Generator — 8 Types, 100% Private"
  description="Generate free QR codes for URLs, WiFi, vCards, and more. 100% private, browser-based, no upload. No signup required."
  schema="faq"
  faqItems={faqItems}>
  <section class="landing-hero">
    <div class="container">
      <h1>Free QR Code Generator</h1>
      <p>Generate any QR code in your browser. URL, WiFi, vCard, and 5 more types. Nothing uploaded, nothing tracked.</p>
      <a href="/#type=url" class="cta">Try the QR Code Generator</a>
    </div>
  </section>
  <section class="landing-howto">
    <div class="container">
      <h2>How to use</h2>
      <ol>
        <li>Choose a QR code type (URL, WiFi, vCard, etc.).</li>
        <li>Fill in your content on the left.</li>
        <li>Customize colors and Logo if desired, then download as PNG, SVG, or JPG.</li>
      </ol>
    </div>
  </section>
  <section class="landing-faq">
    <div class="container">
      <h2>Frequently asked questions</h2>
      {faqItems.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="landing-related">
    <div class="container">
      <h2>Choose a QR code type</h2>
      <ul>
        {relatedTypes.map((r) => (
          <li><a href={`/${r.slug}`}>{r.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>